#!/usr/bin/env node
import fs from 'node:fs/promises';
import crypto from 'node:crypto';
import { rootDir, post, ingest, stored, setState, list, rejections } from '../core/store.js';
import { parseJson, validateStory } from '../core/schema.js';
import { review, runReviewed, receipts } from '../core/actions.js';
import { listProducers, runProducer } from '../core/producers.js';
import { prune, deleteStory } from '../core/prune.js';
import { visible } from '../feed.js';

const usage=`trough post --file FILE | emit --source ID --kind KIND --title TEXT --summary TEXT [--severity LEVEL] [--group-key KEY] [--link LABEL=URL] | validate --file FILE | ingest | prune [--older-than 3d] [--dry-run] | delete ID | ls [--json] [--inbox] [--all] [--unread] [--needs-action] [--done] [--snoozed] [--source ID] [--kind KIND] [--severity LEVEL] [--subject KEY] [--search TEXT] | show ID | read|unread|done|undo ID | snooze ID --until RFC3339 | rejections | review STORY ACTION [--option ID] [--comment TEXT] | run REVIEW_TOKEN | receipts [STORY] | producers | produce ID\nGlobal: --dir DIR (or TROUGH_DIR). --inbox selects unread OR needs action and combines with fields and search using AND; it cannot be combined with --all or state flags. Explicit state flags AND together; repeated values for one field OR together; dimensions AND together. Without a state option, ls shows active unfinished stories; --all includes every state.`;
function parse(argv) {
  const positional=[],opts={};
  for (let i=0;i<argv.length;i++) {
    const x=argv[i];
    if (!x.startsWith('--')) { positional.push(x); continue; }
    const k=x.slice(2);
    if (['json','inbox','unread','needs-action','done','snoozed','all','dry-run'].includes(k)) { opts[k]=true; continue; }
    if (!['dir','file','source','kind','title','summary','severity','subject','search','group-key','link','until','option','comment','older-than'].includes(k) || i+1>=argv.length) throw new Error(`unknown or incomplete option: ${x}`);
    if (k==='link') (opts.link??=[]).push(argv[++i]);
    else if (['source','kind','severity','subject'].includes(k) && positional[0]==='ls') (opts[k]??=[]).push(argv[++i]);
    else { if (opts[k]!==undefined) throw new Error(`duplicate option: ${x}`); opts[k]=argv[++i]; }
  }
  return {positional,opts};
}
const output = value => process.stdout.write(typeof value==='string' ? value+'\n' : JSON.stringify(value,null,2)+'\n');
async function bytesFrom(file) { if (!file) throw new Error('--file is required'); return file==='-' ? new Promise((resolve,reject)=>{ const chunks=[]; process.stdin.on('data',c=>chunks.push(c)); process.stdin.on('end',()=>resolve(Buffer.concat(chunks))); process.stdin.on('error',reject); }) : fs.readFile(file); }
function lsFilters(opts) {
  const states=[['unread','unread'],['needs-action','needs action'],['done','done'],['snoozed','snoozed']].filter(([flag])=>opts[flag]).map(([,state])=>state);
  if(opts.inbox && (opts.all||states.length)) throw new Error('--inbox cannot be combined with --all or state flags');
  return {inbox:opts.inbox,all:opts.all,states,source:opts.source,kind:opts.kind,severity:opts.severity,subject:opts.subject,text:opts.search};
}
async function main() {
  const {positional,opts}=parse(process.argv.slice(2)); const [command,id,...rest]=positional; const root=rootDir(opts.dir);
  if (!command || command==='help') { output(usage); return; }
  if (command==='validate') { const bytes=await bytesFrom(opts.file); validateStory(parseJson(bytes)); output('valid'); return; }
  if (command==='post') { output(await post(root,await bytesFrom(opts.file))); return; }
  if (command==='emit') {
    const links=(opts.link??[]).map((spec,i)=>{ const cut=spec.indexOf('='); if (cut<1) throw new Error('link must be LABEL=URL or LABEL=/absolute/path'); const dest=spec.slice(cut+1); return {id:`link${i+1}`,label:spec.slice(0,cut),...(dest.startsWith('/')?{path:dest}:{url:dest})}; });
    const story={v:1,id:crypto.randomBytes(16).toString('hex'),source:{id:opts.source,label:opts.source},kind:opts.kind,title:opts.title,summary:opts.summary,occurred_at:new Date().toISOString(),severity:opts.severity??'info'};
    if (opts['group-key']) story.group_key=opts['group-key'];
    if (links.length) story.links=links;
    output(await post(root,Buffer.from(JSON.stringify(validateStory(story))+'\n'))); return;
  }
  if (command==='ingest') { output(await ingest(root)); return; }
  if (command==='prune') { if(id||rest.length) throw new Error('prune takes no ID'); output(await prune(root,{olderThan:opts['older-than'],dryRun:opts['dry-run']})); return; }
  if (command==='delete') { if(!id||rest.length) throw new Error('delete needs one story ID'); output(await deleteStory(root,id)); return; }
  if (command==='rejections') { output(await rejections(root)); return; }
  if (command==='producers') { if(id) throw new Error('producers takes no ID'); output(await listProducers(root)); return; }
  if (command==='produce') { if(!id||rest.length) throw new Error('produce needs a producer ID'); output(await runProducer(root,id)); return; }
  if (command==='review') { if (!id||rest.length!==1) throw new Error('review needs STORY and ACTION'); output(await review(root,id,rest[0],{option:opts.option,comment:opts.comment})); return; }
  if (command==='run') { if (!id||rest.length) throw new Error('run needs a review token'); output(await runReviewed(root,id)); return; }
  if (command==='receipts') { if(rest.length) throw new Error('receipts accepts at most one story ID'); output(await receipts(root,id)); return; }
  if (command==='ls') { const rows=visible(await list(root),lsFilters(opts)); if (opts.json) output(rows); else for (const r of rows) output(`${r.story.id}\t${r.story.severity}\t${r.story.source.label}\t${r.story.title}`); return; }
  if (command==='show') { if (!id) throw new Error('story ID required'); await ingest(root); const row=await stored(root,id); output({story:row.story,story_hash:row.hash,received_at:row.received_at}); return; }
  if (['read','unread','done','undo','snooze'].includes(command)) { if (!id) throw new Error('story ID required'); output(await setState(root,id,command,opts.until)); return; }
  throw new Error(`unknown command: ${command}\n${usage}`);
}
main().catch(e=>{ process.stderr.write(`trough: ${e.message}\n`); process.exitCode=1; });
