#!/usr/bin/env node
import fs from 'node:fs/promises';
import crypto from 'node:crypto';
import { rootDir, post, ingest, stored, setState, list, rejections } from '../core/store.js';
import { parseJson, validateStory } from '../core/schema.js';
import { review, act, runReviewed, receipts, openLocalPath, listActions, annotate, listAllowed, revokeAllowed } from '../core/actions.js';
import { listPacks, addPack, removePack } from '../core/packages.js';
import { userHandler, turnOn, turnOff } from '../core/open-handlers.js';
import { listProducers, runProducer } from '../core/producers.js';
import { prune, deleteStory } from '../core/prune.js';
import { checkedImage, withMedia } from '../core/media.js';
import path from 'node:path';
import { visible } from '../feed.js';

const usage=`trough post --file FILE | emit --source ID --kind KIND --title TEXT --summary TEXT [--body MARKDOWN | --body-file FILE] [--image PATH] [--severity LEVEL] [--group-key KEY] [--link LABEL=URL] | validate --file FILE | ingest | prune [--older-than 3d] [--dry-run] | delete ID | ls [--json] [--inbox] [--all] [--unread] [--needs-action] [--done] [--snoozed] [--source ID] [--kind KIND] [--severity LEVEL] [--subject KEY] [--search TEXT] | show ID | read|unread|done|undo ID | snooze ID --until RFC3339 | rejections | review STORY ACTION [--option ID] [--comment TEXT] | run REVIEW_TOKEN [--always-allow] | act STORY ACTION [--option ID] [--comment TEXT] | allow [list] [--json] | allow revoke PACK/HANDLER|all | open STORY PATH | receipts [STORY] | producers | produce ID | packages [list|check] [--json] | packages add PATH|core [--options-file FILE] | packages remove NAME|PATH | actions [--json] | handler [status|on|off]\nGlobal: --dir DIR (or TROUGH_DIR). --app-home DIR names the Herdr home (or HERDR_APP_HOME), where card images are cached and your own open handler lives. --inbox selects unread OR needs action and combines with fields and search using AND; it cannot be combined with --all or state flags. Explicit state flags AND together; repeated values for one field OR together; dimensions AND together. Without a state option, ls shows active unfinished stories; --all includes every state.`;
function parse(argv) {
  const positional=[],opts={};
  for (let i=0;i<argv.length;i++) {
    const x=argv[i];
    if (!x.startsWith('--')) { positional.push(x); continue; }
    const k=x.slice(2);
    if (['json','inbox','unread','needs-action','done','snoozed','all','dry-run','always-allow'].includes(k)) { opts[k]=true; continue; }
    if (!['options-file','dir','app-home','file','source','kind','title','summary','body','body-file','image','severity','subject','search','group-key','link','until','option','comment','older-than'].includes(k) || i+1>=argv.length) throw new Error(`unknown or incomplete option: ${x}`);
    if (k==='link') (opts.link??=[]).push(argv[++i]);
    else if (['source','kind','severity','subject'].includes(k) && positional[0]==='ls') (opts[k]??=[]).push(argv[++i]);
    else { if (opts[k]!==undefined) throw new Error(`duplicate option: ${x}`); opts[k]=argv[++i]; }
  }
  return {positional,opts};
}
const output = value => process.stdout.write(typeof value==='string' ? value+'\n' : JSON.stringify(value,null,2)+'\n');
async function bytesFrom(file) { if (!file) throw new Error('--file is required'); return file==='-' ? new Promise((resolve,reject)=>{ const chunks=[]; process.stdin.on('data',c=>chunks.push(c)); process.stdin.on('end',()=>resolve(Buffer.concat(chunks))); process.stdin.on('error',reject); }) : fs.readFile(file); }
function lsFilters(opts) {
  const states=[['unread','unread'],['needs-action','needs action'],['done','done'],['snoozed','snoozed']].filter(([flag])=>opts[flag]).map(([,state])=>state);
  if(opts.inbox && (opts.all||states.length)) throw new Error('--inbox cannot be combined with --all or state flags');
  return {inbox:opts.inbox,all:opts.all,states,source:opts.source,kind:opts.kind,severity:opts.severity,subject:opts.subject,text:opts.search};
}
async function main() {
  const {positional,opts}=parse(process.argv.slice(2)); const [command,id,...rest]=positional; const root=rootDir(opts.dir);
  if (opts['app-home']!==undefined) { if (!path.isAbsolute(opts['app-home'])) throw new Error('--app-home must be an absolute path'); process.env.HERDR_APP_HOME=opts['app-home']; }
  if (!command || command==='help') { output(usage); return; }
  if (command==='validate') { const bytes=await bytesFrom(opts.file); validateStory(parseJson(bytes)); output('valid'); return; }
  if (command==='post') { output(await post(root,await bytesFrom(opts.file))); return; }
  if (command==='emit') {
    const links=(opts.link??[]).map((spec,i)=>{ const cut=spec.indexOf('='); if (cut<1) throw new Error('link must be LABEL=URL or LABEL=/absolute/path'); const dest=spec.slice(cut+1); return {id:`link${i+1}`,label:spec.slice(0,cut),...(dest.startsWith('/')?{path:dest}:{url:dest})}; });
    const story={v:1,id:crypto.randomBytes(16).toString('hex'),source:{id:opts.source,label:opts.source},kind:opts.kind,title:opts.title,summary:opts.summary,occurred_at:new Date().toISOString(),severity:opts.severity??'info'};
    if (opts['group-key']) story.group_key=opts['group-key'];
    if (opts.body!==undefined && opts['body-file']!==undefined) throw new Error('use --body or --body-file, not both');
    if (opts.body!==undefined) story.body=opts.body;
    if (opts['body-file']!==undefined) story.body=(await bytesFrom(opts['body-file'])).toString('utf8').replace(/\n$/,'');
    if (opts.image!==undefined) {
      // The picture is checked now, so a wrong file fails here rather than on the card.
      const file=path.resolve(opts.image),{type}=await checkedImage(file);
      links.push({id:'image',label:path.basename(file).slice(0,120)||'Image',path:file,role:'screenshot',media_type:type});
      story.image='image';
    }
    if (links.length) story.links=links;
    output(await post(root,Buffer.from(JSON.stringify(validateStory(story))+'\n'))); return;
  }
  if (command==='ingest') { output(await ingest(root)); return; }
  if (command==='prune') { if(id||rest.length) throw new Error('prune takes no ID'); output(await prune(root,{olderThan:opts['older-than'],dryRun:opts['dry-run']})); return; }
  if (command==='delete') { if(!id||rest.length) throw new Error('delete needs one story ID'); output(await deleteStory(root,id)); return; }
  if (command==='rejections') { output(await rejections(root)); return; }
  if (command==='producers') { if(id) throw new Error('producers takes no ID'); output(await listProducers(root)); return; }
  if (command==='produce') { if(!id||rest.length) throw new Error('produce needs a producer ID'); output(await runProducer(root,id)); return; }
  if (command==='review') { if (!id||rest.length!==1) throw new Error('review needs STORY and ACTION'); output(await review(root,id,rest[0],{option:opts.option,comment:opts.comment})); return; }
  if (command==='act') { if (!id||rest.length!==1) throw new Error('act needs STORY and ACTION'); output(await act(root,id,rest[0],{option:opts.option,comment:opts.comment})); return; }
  if (command==='run') { if (!id||rest.length) throw new Error('run needs a review token'); output(await runReviewed(root,id,{alwaysAllow:opts['always-allow']})); return; }
  if (command==='allow') {
    const sub=id??'list';
    if (sub==='revoke') { if(rest.length!==1) throw new Error('allow revoke needs PACK/HANDLER or all'); output(await revokeAllowed(root,rest[0])); return; }
    if (sub!=='list'||rest.length) throw new Error('allow takes list, or revoke PACK/HANDLER|all');
    const rows=await listAllowed(root);
    if (opts.json) output(rows);
    else {
      if (!rows.length) output('No action is always allowed. Confirm a review with `trough run TOKEN --always-allow` to add one.');
      for (const row of rows) output(`${row.key}\t${row.state==='active'?'active':`asks again: ${row.reason}`}\t${row.effects.join('; ')||row.label||'-'}\t${row.at?`since ${row.at}`:'-'}`);
    }
    return;
  }
  if (command==='open') { if (!id||rest.length!==1) throw new Error('open needs STORY and PATH'); output(await openLocalPath(root,id,rest[0])); return; }
  if (command==='receipts') { if(rest.length) throw new Error('receipts accepts at most one story ID'); output(await receipts(root,id)); return; }
  if (command==='packages') {
    const sub=id??'list';
    if (sub==='add') { if(rest.length!==1) throw new Error('packages add needs one PATH'); output(await addPack(root,rest[0],opts['options-file']?JSON.parse(await fs.readFile(opts['options-file'],'utf8')):undefined)); return; }
    if (sub==='remove') { if(rest.length!==1) throw new Error('packages remove needs one NAME or PATH'); output(await removePack(root,rest[0])); return; }
    if (!['list','check'].includes(sub)||rest.length) throw new Error('packages takes list, check, add PATH, or remove NAME|PATH');
    const packs=await listPacks(root),ok=packs.every(pack=>pack.ok);
    if (opts.json) output(sub==='check'?{ok,packs}:packs);
    else {
      if (!packs.length) output('No packs are listed in handlers.json.');
      for (const pack of packs) {
        output(`${pack.name}\t${pack.ok?'ok':'error'}\t${pack.built_in?'(built in)':pack.path}`);
        for (const problem of pack.problems) output(`  problem: ${problem}`);
        output(`  handlers: ${pack.handlers.length?pack.handlers.map(h=>h.available?h.id:`${h.id} (unavailable: ${h.reason})`).join(', '):'none'}`);
        if (pack.user_handler) output(`  your handler: ${pack.user_handler.state}${pack.user_handler.state==='off'?'':` (${pack.user_handler.path??pack.user_handler.location})`}`);
        output(`  augments: ${pack.augments?pack.augments.join('; ')||'yes (no rules described)':'none'}`);
        output(`  producer: ${pack.producer?`${pack.producer.name}, every ${pack.producer.interval_seconds}s, ${pack.producer.last_run?`last run ${pack.producer.last_run}`:'not run yet'}${pack.producer.last_error?`, last error: ${pack.producer.last_error}`:''}`:'none'}`);
      }
      if (sub==='check') output(ok?'check passed':'check failed');
    }
    if (sub==='check'&&!ok) process.exitCode=1;
    return;
  }
  if (command==='handler') {
    if (rest.length||!['status','on','off',undefined].includes(id)) throw new Error('handler takes status, on, or off');
    output(id==='on'?await turnOn():id==='off'?await turnOff():await userHandler()); return;
  }
  if (command==='actions') {
    if(id) throw new Error('actions takes no ID');
    const {handlers,augmenters}=await listActions(root);
    if (opts.json) output({handlers,augmenters});
    else {
      for (const a of handlers) output(`${a.id}\t${a.origin==='pack'?`pack ${a.pack}`:a.origin}\t${a.available?'available':`unavailable: ${a.reason}`}\t${Object.entries(a.args).map(([k,rule])=>`${k}${rule.required?'':'?'}:${rule.type}`).join(' ')||'-'}`);
      for (const a of augmenters) for (const rule of a.rules.length?a.rules:['augments stories (no rules described)']) output(`augment\tpack ${a.pack}\t${rule}`);
    }
    return;
  }
  if (command==='ls') { let rows=visible(await list(root),lsFilters(opts)); if (opts.json) output(await withMedia(root,await annotate(root,rows))); else for (const r of rows) output(`${r.story.id}\t${r.story.severity}\t${r.story.source.label}\t${r.story.title}`); return; }
  if (command==='show') { if (!id) throw new Error('story ID required'); await ingest(root); const row=await stored(root,id); const [{media,media_error}]=await withMedia(root,[{story:row.story}]); output({story:row.story,story_hash:row.hash,received_at:row.received_at,...(media?{media}:{}),...(media_error?{media_error}:{})}); return; }
  if (['read','unread','done','undo','snooze'].includes(command)) { if (!id) throw new Error('story ID required'); output(await setState(root,id,command,opts.until)); return; }
  throw new Error(`unknown command: ${command}\n${usage}`);
}
main().catch(e=>{ process.stderr.write(`trough: ${e.message}\n`); process.exitCode=1; });
