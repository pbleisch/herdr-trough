{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pbleisch/herdr-trough/main/docs/story-v1.schema.json",
  "title": "Trough story v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "source", "kind", "title", "summary", "occurred_at", "severity"],
  "properties": {
    "v": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {
      "id": {"$ref": "#/$defs/key"}, "label": {"$ref": "#/$defs/label"},
      "instance": {"type": "string", "maxLength": 128}, "machine": {"type": "string", "maxLength": 128},
      "terminal": {"type": "string", "maxLength": 128}, "session": {"type": "string", "maxLength": 128}
    }},
    "kind": {"$ref": "#/$defs/key"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
    "occurred_at": {"type": "string", "format": "date-time"},
    "severity": {"enum": ["info", "notice", "warning", "critical"], "description": "Choose the lowest level that fits: info is routine FYI requiring nothing (work landed, merged, deployed, or a report finished); notice seeks operator attention without a problem (decision, approval, credential, hands-on step, or PR review); warning means something went wrong or is at risk (blocked work, failed or refused merge, red CI, or a missed target); critical is urgent because something is down or data is at risk."},
    "outcome": {"enum": ["succeeded", "failed", "pending"]},
    "subject": {"type": "object", "additionalProperties": false, "required": ["type", "key"], "properties": {
      "type": {"$ref": "#/$defs/key"}, "key": {"type": "string", "minLength": 1, "maxLength": 256}, "label": {"type": "string", "maxLength": 200}
    }},
    "group_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "expires_at": {"type": "string", "format": "date-time"},
    "supersedes": {"$ref": "#/$defs/id"},
    "links": {"type": "array", "maxItems": 16, "items": {"oneOf": [
      {"$ref": "#/$defs/urlLink"}, {"$ref": "#/$defs/pathLink"}
    ]}},
    "provenance": {"type": "object", "additionalProperties": false, "properties": {
      "event_id": {"type": "string", "maxLength": 256}, "task_id": {"type": "string", "maxLength": 128},
      "repository_url": {"type": "string", "maxLength": 2048}, "head": {"type": "string", "maxLength": 128},
      "reference": {"type": "string", "maxLength": 2048}
    }},
    "actions": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/action"}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["question_id", "prompt", "options"], "properties": {
      "question_id": {"$ref": "#/$defs/key"}, "prompt": {"type": "string", "minLength": 1, "maxLength": 4096},
      "options": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "label", "answer_text"], "properties": {"id": {"$ref": "#/$defs/key"},
          "label": {"type": "string", "minLength": 1, "maxLength": 120}, "answer_text": {"type": "string", "minLength": 1, "maxLength": 512}}}},
      "allow_comment": {"type": "boolean"}
    }},
    "extensions": {"type": "object", "maxProperties": 16, "patternProperties": {"^[a-z0-9]+(?:[.-][a-z0-9]+)+$": {}}, "additionalProperties": false}
  },
  "allOf": [{"if": {"properties": {"kind": {"const": "decision"}}, "required": ["kind"]},
    "then": {"required": ["decision"]},
    "else": {"not": {"required": ["decision"]}}},
    {"if": {"properties": {"actions": {"contains": {"anyOf": [
      {"properties": {"handler": {"const": "answer_decision"}}, "required": ["handler"]},
      {"properties": {"choice": {"const": true}}, "required": ["choice"]}
    ]}}}, "required": ["actions"]},
    "then": {"properties": {"decision": {"properties": {"options": {"minItems": 2}}}}}}],
  "$defs": {
    "id": {"type": "string", "oneOf": [{"pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"}, {"pattern": "^[0-9a-f]{32}$"}]},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 128},
    "urlLink": {"type": "object", "additionalProperties": false, "required": ["id", "label", "url"], "properties": {
      "id": {"$ref": "#/$defs/key"}, "label": {"type": "string", "minLength": 1, "maxLength": 120},
      "url": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048},
      "role": {"$ref": "#/$defs/linkRole"}, "media_type": {"$ref": "#/$defs/mediaType"}}},
    "pathLink": {"type": "object", "additionalProperties": false, "required": ["id", "label", "path"], "properties": {
      "id": {"$ref": "#/$defs/key"}, "label": {"type": "string", "minLength": 1, "maxLength": 120},
      "path": {"type": "string", "minLength": 1, "maxLength": 4096},
      "role": {"$ref": "#/$defs/linkRole"}, "media_type": {"$ref": "#/$defs/mediaType"}}},
    "linkRole": {"$ref": "#/$defs/key", "description": "What the link is, so packs can offer fitting actions. Conventional values: report, document, artifact, log, screenshot, pr, issue, source. Other keys are allowed."},
    "mediaType": {"type": "string", "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,62}/[a-z0-9][a-z0-9!#$&^_.+-]{0,62}$", "description": "Lowercase media type of the destination, such as text/markdown or application/pdf."},
    "action": {"type": "object", "additionalProperties": false, "required": ["id", "label", "handler"], "properties": {
      "id": {"$ref": "#/$defs/key"}, "label": {"type": "string", "minLength": 1, "maxLength": 120},
      "handler": {"$ref": "#/$defs/key"}, "choice": {"type": "boolean"},
      "args": {"type": "object", "maxProperties": 12, "patternProperties": {"^[a-z][a-z0-9_-]{0,63}$": {
        "oneOf": [{"type": "string", "maxLength": 8192}, {"type": "number"}, {"type": "boolean"}]}}, "additionalProperties": false}
    }}
  }
}
